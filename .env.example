# DATABASE
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=db_name
POSTGRES_LOCAL_PORT=5432

# API
DATABASE_URL=postgres://username:db_name@database:5432/password
PORT=3000
API_LOCAL_PORT=3000
NODE_ENV='development'

# SECRET
JWT_SECRET=YOUR_SECRET_KEY
ALLOWED_ORIGINS=http://localhost:PORT_FRONT

# IGDB (Twitch Dev Console: https://dev.twitch.tv/console)
IGDB_CLIENT_ID=your_twitch_client_id
IGDB_CLIENT_SECRET=your_twitch_client_secret
# ON UTILISERA JAMAIS ALLOWED_ORIGINS=* DANS UN CONTEXT DE REPOS FRONT =/= BACK, UTILISATION DE COOKIES, CORS(CREDENTIAL = TRUE) SINON => ERREUR CORS
# L'ADRESSE DOIT ÊTRE STRICT
